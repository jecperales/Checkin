<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>GP | Asistencia</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"> 
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/sweetalert.min.js"></script>
    <script src="~/Scripts/angular1_6_1.js"></script>
    <script src="~/Scripts/ui-bootstrap-tpls-3.0.3.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
  

</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light  border-bottom mb-5" style=" background: rgb(5,52,57); background: linear-gradient(90deg, rgba(5,52,57,0.8267507686668417) 20%, rgba(2,108,187,0.9079832616640406) 100%); ">

        <a class="navbar-brand ml-4" href="#">
            <img src="~/imagen/logo_pissa_web.png" alt="Logo" width="120" height="44" class="d-inline-block align-text-top">
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                @{
                    var profile = ViewBag.profile;

                    if (profile == 2 || profile == 3)
                    {
                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold gradient-primary-light" href="@Url.Action("Index", "Asistencia")">Reporte Asistencia <span class="sr-only">(current)</span></a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" href="@Url.Action("chekAsistencia", "Asistencia")">Registra Asistencia</a>
                        </li>
                        @*<li class="nav-item">
                            <a class="collapse-item" href="@Url.Action("Index", "Perfil")">Perfil</a>
                        </li>*@
                    }

                    if (profile == 1)
                    {
                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold text-light" href="@Url.Action("Index", "Asistencia")">Reporte Asistencia <span class="sr-only">(current)</span></a>
                        </li>
                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold text-light" href="@Url.Action("chekAsistencia", "Asistencia")">Registra Asistencia</a>
                        </li>
                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold text-light" href="@Url.Action("altapersonal", "Asistencia")">Alta personal</a>
                        </li>

                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold text-light" href="@Url.Action("Index", "Area")">Areas</a>
                        </li>

                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold text-light" href="@Url.Action("Charts", "Asistencia")">Estadisticas</a>
                        </li>
                    }

                    if (profile == 4)
                    {
                        <li class="nav-item active">
                            <a class="nav-link font-weight-bold" href="@Url.Action("Index", "Asistencia")">Reporte Asistencia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" href="@Url.Action("Charts", "Asistencia")">Estadisticas</a>
                        </li>
                    }
                }
            </ul>
        </div>
    </nav>

    @RenderBody()


</body>
</html>
