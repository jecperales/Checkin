        if ("geolocation" in navigator) {
            //Verificar si los permisos de ubicacion estan concedidos
            navigator.permissions.query({ name: 'geolocation' }).then(function (res) {
                if (res.state === 'granted') {
                    //Los permisos de ubicacion estan concedidos
                    navigator.geolocation.getCurrentPosition(function (position) {
                        latitud = position.coords.latitude;
                        longitud = position.coords.longitude;
                    });

                    if (funcionAllamar === "regasistencias") {
                        regasistencias();
                    }
                    else if (funcionAllamar === "registrarSalida")
                    {
                        registrarSalida();
                    }
                }

                if (res.state === 'prompt') {
                    //Los permisos no estan concedidos pero se pueden solicitar al usuario
                    navigator.geolocation.getCurrentPosition(function (position) {
                        latitud = position.coords.latitude;
                        longitud = position.coords.longitude;
                    });
                    res.onchange = function () {
                        //Verifica si el usuario concede los permisos
                        if (this.state === 'granted') {

                            navigator.geolocation.getCurrentPosition(function (position) {
                                latitud = position.coords.latitude;
                                longitud = position.coords.longitude;

                            });

                            if (funcionAllamar === "regasistencias") {
                                regasistencias();
                            }
                            else if (funcionAllamar === "registrarSalida") {
                                registrarSalida();
                            }

                        }
                        else {
                            swal("El usuario no concedio los permisos de ubicacion", "PERMISOS", "error");
                        }
                    }
                }
                else {
                    //Los permisos de ubicacion no estan concedidos y no se pueden solicitar
                    swal("Los permisos de ubicacion no estan concedidos y no se puden solicitar. Activelos manualmente!", "PERMISOS", "warning");
                }
            });
        }
        else {
            //El navegar no soportada por este navegador
            swal("Geolocalizacion no soportada por este navegador", "PERMISOS", "error");
        }

    }

    function handleChange(permissionName, newState) {

        if ('geolocation' in navigator) {
            if (newState === 'granted') {
                swal("Los permisos de ubicacion fueron concedidos correctamente. Ya puede rgistrar su asistencia", "PERMISOS", "success");
            }
            else if (newState === 'prompt') {
                swal("Los permisos de ubicacion no fueron concedidos. Se solicitaran la proxima vez que registre su asistencia", "PERMISOS", "warning");
            }
            else {
                //Los permisos de ubicacion no estan concedidos y no se pueden solicitar
                swal("Los permisos de ubicacion no fueron concedidos y no se puden solicitar. Activelos manualmente!", "PERMISOS", "error");
            }
        }
        else {
            //El navegar no soportada por este navegador
            swal("Geolocalizacion no soportada por este navegador", "PERMISOS", "error");
        }
    }

    function checkGeolocationPermission(permissionName, descriptor) {
        try {

            if ('geolocation' in navigator) {

                navigator.permissions.query(Object.assign({ name: permissionName }, descriptor)).then(function (permission) {

                    estado = permission.state;

                    if (permission.state === 'granted') {

                        navigator.geolocation.getCurrentPosition(
                            function (position) {
                                latitud = position.coords.latitude;
                                longitud = position.coords.longitude;

                                if (funcionName === "regasistencias") {
                                    regasistencias();
                                }
                                else if (funcionName === "registrarSalida") {
                                    registrarSalida();
                                }

                            }
                        );

                    }
                    else if (permission.state === 'prompt') {

                        navigator.geolocation.getCurrentPosition(noop);
                    }
                    else {
                        //Los permisos de ubicacion no estan concedidos y no se pueden solicitar
                        swal("Los permisos de ubicacion no fueron concedidos y no se puden solicitar. Activelos manualmente!", "PERMISOS NO CONCEDIDOS", "warning");
                    }

                    permission.addEventListener('change', function (e) {
                        handleChange(permissionName, permission.state);
                    });

                });
            }
            else {
                //El navegar no soportada por este navegador
                swal("Geolocalizacion no soportada por este navegador", "PERMISOS", "error");
            }
        }
        catch (e) {
            console.log(e);
        }
    }

    function requestGeolocation(funcDesc) {
        checkGeolocationPermission("geolocation");
        funcionName = funcDesc;
    }

    var noop = function () { }

    function regasistencias() {

        var d = new Date().toISOString();

        var control = {
            latitud: latitud,
            longitud: longitud,
            fecha_hora_movil: d,
            fecha_hora_registro: d,
            id_ingeniero: 0,
            fecha_hora_salida: '',
            s_latitud : 0,
            s_longitud :0
        };

        $.ajax({
                type: "POST",
                url: "@Url.Action("regasistencias", "Asistencia")",
                content: "application/json; charset=utf-8",
                dataType: "json",
                data: control,
                success: function (data) {
                    if (data) {

                        swal("Correcto.", "Asistencia registrada", "success");

                        var alert = document.getElementById("alertEntrada");
                        var registrarEntradaBtn = document.getElementById("registrarEntradaBtn");
                        var fechaEntrada= new Date().toLocaleString();

                        registrarEntradaBtn.disabled = true;
                        document.getElementById("pFechaHoraEntrada").innerHTML = fechaEntrada;

                        if (alert.style.display === "none") {
                            alert.style.display = "block";
                        }
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error!!: ' + errorThrown );
                }
        });

    }

    function registrarSalida() {

        var c = new Date().toISOString();

        var control = {
                latitud: 0,
                longitud: 0,
                fecha_hora_movil: '',
                fecha_hora_registro: '',
                id_ingeniero: 0,
                fecha_hora_salida : c,
                s_latitud : latitud,
                s_longitud: longitud
        };

        $.ajax({
                type: "POST",
                url: "@Url.Action("registraSalida", "Asistencia")",
                content: "application/json; charset=utf-8",
                dataType: "json",
                data: control,
                success: function (data) {
                    if (data != "0") {
                        swal("Correcto.", "Salida regtistrada", "success");

                        var alert = document.getElementById("alertSalida");
                        var registrarSalidaBtn = document.getElementById("registrarSalidaBtn");
                        var fechaSalida = new Date().toLocaleString();

                        registrarEntradaBtn.disabled = true;
                        document.getElementById("pFechaHoraSalida").innerHTML = fechaSalida;

                        registrarSalidaBtn.disabled = true;

                        if (alert.style.display === "none") {
                            alert.style.display = "block";
                        }

                    } else if (data == "0") {
                        swal("Warning.", "No hay registro del dia de hoy. Asegurate que hayas registrado tu entrada primero!.", "info");
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert('Error!!');
                }
        });

    }

</script>


