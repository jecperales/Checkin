@{ ViewBag.Title = "altapersonal"; }
@using pissa.Asistencia.Models;
@model tipoProyecto
@*@model Modelos*@

<div class="container-fluid" ng-app="myApp" ng-controller="myCtrl">

    <div class="row col-12 m-3">

        <div class="row col-12 border-bottom mb-4">
            <h1>Alta de Ingenieros</h1>
        </div>

        <div class="row col-12 mb-4">
            <div class="col-md-3">
                <label>Nombre</label>
                <input class="form-control" ng-model="nombre" id="nombre" />
            </div>
            <div class="col-md-3">
                <label>Apellido paterno</label>
                <input class="form-control" ng-model="ap_paterno" id="apellidoPaterno" />
            </div>
            <div class="col-md-3">
                <label>Apellido materno</label>
                <input class="form-control" ng-model="ap_materno" id="apellidoMaterno" />
            </div>
            <div class="col-md-3">
                <label>Celular</label>
                <input class="form-control" maxlength="10" id="celular" ng-model="celular" />
            </div>
        </div>

        <div class="row col-12">
            <div class="col-md-3">
                <label>Usuario</label>
                <input class="form-control" ng-model="usuario" id="usuario" />
            </div>
            <div class="col-md-3">
                <label>Contraseña</label>
                <input class="form-control" ng-model="psw" id="pwd" />
            </div>
            <div class="col-md-2">
                <label>Perfil</label>
                <select ng-model="perfilDesc" class="form-control multiSProyecto" ng-options="perf.name for perf in perfilArr" ng-change="onChangePerfil(perf)" id="sPerfil"></select>
            </div>
            <div class="col-md-2">
                <label>Proyecto</label>
                <select ng-model="selectArea" class="form-control multiSProyecto" ng-options="a.label for a in TArea" id="sProyecto"></select>
            </div>
            <div class="col-md-2" style="display:none">
                <label># Imei</label>
                <input class="form-control" maxlength="15" ng-model="emei" id="imei" />
            </div>
            <div class="col-md-2" style="display:none">
                <label>Modelo de Telefono</label>
                <select ng-model="selectTelefono" class="form-control" ng-options="a.label for a in Ttelefono" id="sTelefono"></select>
            </div>

            <div class="col-md-2">
                <label>País</label>
                <select ng-model="selectCountry" class="form-control" ng-options="a.name for a in Tcountry" id="sPais">
                </select>
            </div>
        </div>

        <div class="row col-12 mt-1">
            <div class="col-md-3">
                <br />
                <button class="btn btn-success w-100" ng-click="limpear()">
                    <i class="fa fa-trash-o"> Limpiar</i>
                </button>
            </div>
            <div class="col-md-3" ng-if="bool_modifica==false">
                <br />
                <button class="btn btn-success w-100" ng-click="registrar()">
                    <i class="fa fa-save"> Registrar</i>
                </button>
            </div>
            <div class="col-md-3" ng-if="bool_modifica==true">
                <br />
                <button class="btn btn-success w-100" ng-click="modificar()">
                    <i class="fa fa-save"> Modificar</i>
                </button>
            </div>
        </div>

        <div class="row col-12 mt-5">
           
            <div class="table-responsive">
                <table class="table table-hover table-striped">                    
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido paterno</th>
                            <th>Apellido materno</th>
                            <th>Perfil</th>
                            <th>Proyecto/Area</th>
                            <th style="display:none">Emei</th>
                            <th>País</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="d in Tusuario">
                            <td>{{d.nombre}}</td>
                            <td>{{d.appaterno}}</td>
                            <td>{{d.apmaterno}}</td>
                            <td>{{d.perfilDesc}}</td>
                            <td>{{d.area}}</td>
                            <td style="display:none">{{d.imei}}</td>
                            <td>{{d.pais}}</td>
                            <td>
                                <div style="float: left; width: 35px; cursor: pointer;"><i class="fa fa-user-edit text-primary" title="Editar" ng-click="editar(d)"></i></div>
                                <div style="float: left; width: 35px; cursor: pointer;"><i class="fa fa-trash-alt text-danger" title="Eliminar" ng-click="eliminarIngeniero(d)"></i></div>
                            </td>
                            @*<td style="display: none">{{d.id_mov}}</td>*@
                        </tr>
                    </tbody>
                </table>
                <div style="text-align: center">
                    <ul uib-pagination total-items="totalCount" ng-model="pageIndex" ng-change="pageChanged()" items-per-page="pageSizeSelected" direction-links="true" max-size="maxSize" class="pagination" boundary-links="true" rotate="false" num-pages="numPages"></ul>
                </div>
            </div>
        </div>

    </div>

